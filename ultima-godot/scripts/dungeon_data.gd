	"####################",
]

const MAP_W: int = 20
const MAP_H: int = 27

static func is_wall(x: int, y: int, door_open: bool) -> bool:
	if x < 0 or y < 0 or x >= MAP_W or y >= MAP_H:
		return true
	var c := MAP[y][x]
	if c == '#':
		return true
	if c == 'D':
		return not door_open
	return false


static func get_tile(x: int, y: int) -> String:
	if x < 0 or y < 0 or x >= MAP_W or y >= MAP_H:
		return "#"
	return MAP[y][x]

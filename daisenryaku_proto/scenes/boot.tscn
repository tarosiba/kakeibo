[gd_scene load_steps=2 format=3 uid="uid://boot_scene"]

[ext_resource type="Script" path="res://scripts/boot.gd" id="1_boot"]

[node name="Boot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_boot")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -150.0
offset_right = 180.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "大戦略プロトタイプ"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.75, 1)
text = "Godot 4 Hex Strategy"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="ContinueButton" type="Button" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "続きから (セーブなし)"

[node name="PlayDefaultButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "デフォルトマップでプレイ"

[node name="PlayCustomButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "カスタムマップでプレイ"

[node name="MapEditorButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "マップエディタ"

[node name="QuitButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "終了"

[connection signal="pressed" from="Panel/VBox/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="Panel/VBox/PlayDefaultButton" to="." method="_on_play_default_pressed"]
[connection signal="pressed" from="Panel/VBox/PlayCustomButton" to="." method="_on_play_custom_pressed"]
[connection signal="pressed" from="Panel/VBox/MapEditorButton" to="." method="_on_map_editor_pressed"]
[connection signal="pressed" from="Panel/VBox/QuitButton" to="." method="_on_quit_pressed"]

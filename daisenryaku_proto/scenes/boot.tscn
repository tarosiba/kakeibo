[gd_scene load_steps=4 format=3 uid="uid://boot_scene"]

[ext_resource type="Script" path="res://scripts/boot.gd" id="1_boot"]
[ext_resource type="Texture2D" path="res://assets/ui/menu_background.png" id="2_menu_bg"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.1, 0.12, 0.16, 0.88)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 16.0
content_margin_top = 16.0
content_margin_right = 16.0
content_margin_bottom = 16.0

[node name="Boot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_boot")

[node name="MenuBackground" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_menu_bg")
expand_mode = 1
stretch_mode = 6

[node name="DimOverlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.02, 0.04, 0.1, 0.25)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -260.0
offset_right = 240.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.95, 0.95, 1)
text = "大戦略プロトタイプ"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.85, 0.95, 1)
text = "Godot 4 Hex Strategy"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="NewGameTitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "新規ゲーム"

[node name="MapRow" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="MapLabel" type="Label" parent="Panel/VBox/MapRow"]
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
text = "マップ"

[node name="MapOption" type="OptionButton" parent="Panel/VBox/MapRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="DifficultyRow" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="DifficultyLabel" type="Label" parent="Panel/VBox/DifficultyRow"]
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
text = "難易度"

[node name="DifficultyOption" type="OptionButton" parent="Panel/VBox/DifficultyRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="DifficultyDescription" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.8, 0.9, 1)
text = "標準バランス"
autowrap_mode = 2

[node name="StartGameButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "ゲーム開始"

[node name="NewGameSpacer" type="Control" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="SlotTitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "続きから (セーブスロット)"

[node name="SlotButtons" type="VBoxContainer" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="SlotSpacer" type="Control" parent="Panel/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="MapEditorButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "マップエディタ"

[node name="QuitButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "終了"

[connection signal="item_selected" from="Panel/VBox/DifficultyRow/DifficultyOption" to="." method="_on_difficulty_option_item_selected"]
[connection signal="pressed" from="Panel/VBox/StartGameButton" to="." method="_on_start_game_pressed"]
[connection signal="pressed" from="Panel/VBox/MapEditorButton" to="." method="_on_map_editor_pressed"]
[connection signal="pressed" from="Panel/VBox/QuitButton" to="." method="_on_quit_pressed"]
